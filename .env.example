# Copy this file to .env (next to main.py, or next to Zyraena.exe) and fill it in.
# Lines starting with # are comments. Values are single-line.

# --- Required ---------------------------------------------------------------
# OpenRouter key: every chat mode, voice and transcription goes through OpenRouter.
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Tavily key for web search. https://app.tavily.com
TAVILY_API_KEY=

# --- You --------------------------------------------------------------------
# Your name as shown in the chat window (default: You).
ZYRAENA_USER_NAME=

# --- Modes ------------------------------------------------------------------
# Switch in chat with /mode lady or /mode assistant (/mode alone shows the current one).
# New chats start in this mode: assistant | lady
ZYRAENA_DEFAULT_MODE=assistant
# Models per mode (empty = these defaults).
OPENROUTER_ASSISTANT_MODEL=google/gemini-3.7-flash
OPENROUTER_LADY_MODEL=anthropic/claude-haiku-5.5
# Optional system prompt for assistant mode (one line). Empty = a neutral assistant prompt.
ASSISTANT_PERSONALITY=
# Lady mode's persona comes from personality.md (see personality.example.md).
# Without that file this one-line fallback is used:
ZYRAENA_PERSONALITY=

# --- PC access --------------------------------------------------------------
# Folders Zyraena may read/change, separated by ; (default: Desktop;Downloads;Documents).
ZYRAENA_ALLOWED_DIRS=

# --- Telegram (optional) -----------------------------------------------------
# Path to claude_comm.py, which owns the Telegram bot connection (see README).
CLAUDE_COMM_PATH=

# --- /c: hand tasks to Claude Code (optional) --------------------------------
# claude executable (default: `claude` on PATH, else the VS Code extension's copy).
CLAUDE_CODE_PATH=
# Folder Claude Code works in (default: Documents\Projects).
CLAUDE_CODE_CWD=
# More folders it may read and edit, separated by ; (default: Documents\Work).
CLAUDE_CODE_EXTRA_DIRS=

# --- Sleep mode ---------------------------------------------------------------
# Where sleep-mode jobs may work, separated by ; (default: Documents\Projects;Documents\Work).
ZYRAENA_SLEEP_ROOTS=
# Where the "before" copies go (default: Documents\Failsafe).
ZYRAENA_FAILSAFE_DIR=

# --- Health monitor -----------------------------------------------------------
# Warns you (popup + Telegram) when a value stays past its limit; without an answer for
# 10 minutes it ends the process using most of it. off = don't watch (sleep mode still
# turns it on while it works).
ZYRAENA_HEALTH=on
# Limits (empty = these defaults). GPU temperature needs an NVIDIA GPU (nvidia-smi).
ZYRAENA_HEALTH_GPU_TEMP=87
ZYRAENA_HEALTH_RAM_PERCENT=92
ZYRAENA_HEALTH_CPU_PERCENT=95
ZYRAENA_HEALTH_DISK_FREE_PERCENT=5
# How long a value must stay past its limit before it counts (CPU load has its own).
ZYRAENA_HEALTH_SUSTAIN_MINUTES=2
ZYRAENA_HEALTH_CPU_MINUTES=5

# --- Voice (optional) --------------------------------------------------------
# Text-to-speech model and voice on OpenRouter.
ZYRAENA_TTS_MODEL=openai/gpt-audio-mini
ZYRAENA_TTS_VOICE=shimmer
# Convert the spoken voice with an RVC voice pack from the Wichelberg voice changer
# (slower, ~1.4 GB RAM). Empty = off.
ZYRAENA_VOICE_PACK=
# Wichelberg's _wichelberg folder (default: Documents\Apps\Wichelberg\_wichelberg).
ZYRAENA_WICHELBERG_DIR=
