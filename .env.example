# Copy this file to .env (next to main.py, or next to Zyraena.exe) and fill it in.
# Lines starting with # are comments. Values are single-line.

# --- Required ---------------------------------------------------------------
# OpenRouter key: every chat mode goes through OpenRouter (transcription too, unless local
# speech-to-text is set up: see Voice below). Spoken replies never do: they're made on this PC.
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Tavily key for web search. https://app.tavily.com
TAVILY_API_KEY=

# --- You --------------------------------------------------------------------
# Your name as shown in the chat window (default: You).
ZYRAENA_USER_NAME=

# --- Modes ------------------------------------------------------------------
# Switch in chat with /mode lady or /mode assistant (/mode alone shows the current one).
# New chats start in this mode: assistant | lady
ZYRAENA_DEFAULT_MODE=assistant
# Models per mode (empty = these defaults).
OPENROUTER_ASSISTANT_MODEL=google/gemini-3.7-flash
OPENROUTER_LADY_MODEL=anthropic/claude-haiku-5.5
# Optional system prompt for assistant mode (one line). Empty = a neutral assistant prompt.
ASSISTANT_PERSONALITY=
# Lady mode's persona comes from personality.md (see personality.example.md).
# Without that file this one-line fallback is used:
ZYRAENA_PERSONALITY=

# --- PC access --------------------------------------------------------------
# Folders Zyraena may read/change, separated by ; (default: Desktop;Downloads;Documents).
ZYRAENA_ALLOWED_DIRS=

# --- Telegram (optional) -----------------------------------------------------
# Path to claude_comm.py, which owns the Telegram bot connection (see README).
CLAUDE_COMM_PATH=

# --- /c: hand tasks to Claude Code (optional) --------------------------------
# claude executable (default: `claude` on PATH, else the VS Code extension's copy).
CLAUDE_CODE_PATH=
# Folder Claude Code works in (default: Documents\Projects).
CLAUDE_CODE_CWD=
# More folders it may read and edit, separated by ; (default: Documents\Work).
CLAUDE_CODE_EXTRA_DIRS=

# --- Sleep mode ---------------------------------------------------------------
# Where sleep-mode jobs may work, separated by ; (default: Documents\Projects;Documents\Work).
ZYRAENA_SLEEP_ROOTS=
# Where the "before" copies go (default: Documents\Failsafe).
ZYRAENA_FAILSAFE_DIR=

# --- Health monitor -----------------------------------------------------------
# Warns you (popup + Telegram) when a value stays past its limit; without an answer for
# 10 minutes it ends the process using most of it. off = don't watch (sleep mode still
# turns it on while it works).
ZYRAENA_HEALTH=on
# Limits (empty = these defaults). GPU temperature needs an NVIDIA GPU (nvidia-smi).
ZYRAENA_HEALTH_GPU_TEMP=87
ZYRAENA_HEALTH_RAM_PERCENT=92
ZYRAENA_HEALTH_CPU_PERCENT=95
ZYRAENA_HEALTH_DISK_FREE_PERCENT=5
# How long a value must stay past its limit before it counts (CPU load has its own).
ZYRAENA_HEALTH_SUSTAIN_MINUTES=2
ZYRAENA_HEALTH_CPU_MINUTES=5

# --- Desktop pet ---------------------------------------------------------------
# Zyraena walking along the bottom of the screen. off = don't show her (the Ctrl+F1 panel can still
# bring her back for the session).
ZYRAENA_PET=on
# Her height in pixels (empty = 340).
ZYRAENA_PET_HEIGHT=

# --- Voice (optional) --------------------------------------------------------
# Speech-to-text: local = Whisper on this PC (free; set it up once with
# `python setup_voice_env.py`), falling back to OpenRouter if it's missing or fails.
# openrouter = always the assistant mode's model on OpenRouter.
ZYRAENA_STT=local
# Local Whisper model (a faster-whisper name like large-v3-turbo, a Hugging Face id, or a
# model folder) and language (tr, en, ... or auto). Run setup_voice_env.py after changing
# the model: Zyraena never downloads one. Empty = RsGoksel/RsGoksel_ITU_Mainframe-ct2
# (turbo fine-tuned for Turkish), tr.
ZYRAENA_STT_MODEL=
ZYRAENA_STT_LANGUAGE=
# Optional words to steer spelling (e.g. names), passed to Whisper as its prompt.
ZYRAENA_STT_PROMPT=
# Unload the model after this many minutes unused, freeing ~1.2 GB VRAM (0 = keep it loaded).
ZYRAENA_STT_IDLE_MINUTES=10
# Where voice_env, the Whisper model and your voice clips live (default %LOCALAPPDATA%\Zyraena\voice).
ZYRAENA_VOICE_HOME=
# Python of voice_env (empty = the one setup_voice_env.py made).
ZYRAENA_STT_PYTHON=
# The venv voice_env borrows torch's CUDA libraries from; only setup_voice_env.py reads it
# (default Documents\Projects\Wichelberg_VoiceChanger\data\egitim\venv).
ZYRAENA_TORCH_VENV=
# Keep confirmed voice clips (Telegram "Yes", âœ“/âœŽ under a ðŸŽ¤ transcript, voice_recorder.py)
# for training speech-to-text on your voice. off = keep nothing.
ZYRAENA_VOICE_DATA=on
# Text-to-speech, only on this PC: Chatterbox in tts_env (free; reads sentence by sentence, then the
# voice pack makes it Zyraena's voice). When it can't run (tts_env missing, a game, or the GPU busy:
# ZYRAENA_TTS_GPU_BUSY percent, default 40, 0 = don't check) the reply stays as text; speech is never
# sent to a paid service. off = no spoken replies. Unloaded after ZYRAENA_TTS_IDLE_MINUTES (default 10).
ZYRAENA_TTS=local
ZYRAENA_TTS_GPU_BUSY=
ZYRAENA_TTS_IDLE_MINUTES=
# Turkish reference clip for the local voice's intonation (default voice\tts_models\reference_tr.wav).
ZYRAENA_TTS_REFERENCE=
# Convert the spoken voice with an RVC voice pack from the Wichelberg voice changer
# (a folder, or a name in Wichelberg's library, e.g. zyraena). Empty = off.
ZYRAENA_VOICE_PACK=
# Where the voice pack runs: empty = the GPU (DirectML, only if its output matches the CPU's;
# up to ~2 GB of VRAM; nothing runs during a game); cpu = always the CPU.
ZYRAENA_RVC_DEVICE=
# Language of the text box, the Ctrl+F1 panel, the yes/no box and the pet's lines: tr (default) or en.
ZYRAENA_LANGUAGE=
# "Zyraena aÃ§Ä±l" starts a spoken conversation (wake.py, voice_session.py). Only on mains power with no
# game running (voice_guard "ready"); on battery or in a game the microphone is closed. off = never.
ZYRAENA_WAKE=
# Unload the voice pack after this many idle minutes (default 3; it reloads in ~2 s on ðŸŽ¤).
ZYRAENA_RVC_IDLE_MINUTES=
# Wichelberg's _wichelberg folder (default: Documents\Apps\Wichelberg\_wichelberg).
ZYRAENA_WICHELBERG_DIR=
